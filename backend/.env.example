# Copy to .env (never commit .env). Everything here is optional for local use.

# --- Admin account -----------------------------------------------------------
# On startup the app creates this admin if it does not exist yet. It never
# overwrites an existing password, so you can change it later in Profile.
# You can also promote an existing account:  python -m app.make_admin you@example.com
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-passphrase-with-a-number-1

# --- Database ----------------------------------------------------------------
# Default is a local SQLite file (dev.db). For MySQL:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/growth_tracker
# Railway gives "mysql://..." and that works too; the app adds the driver.

# --- Security ----------------------------------------------------------------
# Leave JWT_SECRET empty and the app generates a strong one and keeps it in the database.
# Set it only if you run several servers against one database.
# JWT_SECRET=
# Hours a login lasts (default 168 = 7 days).
# TOKEN_HOURS=168
# Set to false to close sign-ups once your friends have joined.
# ALLOW_REGISTRATION=true

# --- Production only ---------------------------------------------------------
# The URL of your Vercel frontend (comma-separate several). Default "*" is fine locally.
# CORS_ORIGINS=https://your-app.vercel.app
